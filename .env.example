# ---- Zorunlu anahtarlar (GitHub'da repo Secrets olarak eklenir) ----

# OpenRouter API anahtari (ucretsiz): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Binance Square OpenAPI anahtari:
# https://www.binance.com/square/creator-center/home  (Creator Center > API)
BINANCE_SQUARE_OPENAPI_KEY=

# ---- Opsiyonel: X (Twitter) entegrasyonu ----
# developer.x.com > App > Keys and tokens (Free katman yeterli)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Tweetlerde paylasilacak referans linki
X_REFERRAL_LINK=https://www.binance.com/activity/referral-entry/CPA?ref=CPA_001D41FKZ1

# ---- Opsiyonel ayarlar ----

# Makale yazan model. Ucretsiz modeller:
#   google/gemma-4-31b-it:free   (varsayilan, cok dilli)
#   z-ai/glm-5.2:free
#   nvidia/nemotron-3-super-120b-a12b:free
#   openrouter/free              (otomatik ucretsiz model secimi)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Haberin makale adayina donusmesi icin toplanacak maksimum haber sayisi
MAX_CANDIDATES=14

# Makale kelime araligi
ARTICLE_MIN_WORDS=350
ARTICLE_MAX_WORDS=600

# ---- Video uretimi (video.mjs) ----

# Video hangi dillerde uretilsin (virgulle ayirin)
VIDEO_LANGS=en

# Videolarin alt kosesinde gorunen imza
# VIDEO_FOOTER=@Mr_Emanetson | Binance Square
